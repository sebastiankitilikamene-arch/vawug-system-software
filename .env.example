# Database Configuration
DATABASE_URL=postgresql://vawug_user:vawug_secure_password@localhost:5432/vawug_sacco
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=vawug_user
DATABASE_PASSWORD=vawug_secure_password
DATABASE_NAME=vawug_sacco

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# API Gateway Configuration
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Frontend Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_ENV=development

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@vawug.ke

# SMS Configuration
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_api_key
SMS_API_SECRET=your_twilio_api_secret
SMS_FROM_NUMBER=+254XXXXXXXXX

# File Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Security Configuration
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
